# Copy this file to .env.local and fill in the values. Never commit .env.local.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Supabase project URL: Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase SECRET key (sb_secret_...): Supabase → Project Settings → API Keys → Secret keys.
# Used only on the server. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# bcrypt hash of your PIN. Generate it with:  npm run hash-pin
PIN_HASH=

# Random secret (32+ characters) for signing the login cookie. `npm run hash-pin` prints one.
SESSION_SECRET=

# Optional: time zone used for "today" (default Asia/Kolkata)
# APP_TIME_ZONE=Asia/Kolkata
